{
  "name": "sveltekit-rate-limiter",
  "version": "0.7.0",
  "author": "Andreas Söderlund <ciscoheat@gmail.com> (https://blog.encodeart.dev)",
  "description": "A modular rate limiter for SvelteKit. Use in password resets, account registration, etc.",
  "keywords": [
    "sveltekit",
    "rate",
    "limiting",
    "rate limiter",
    "throttle",
    "limiter"
  ],
  "license": "MIT",
  "bugs": "https://github.com/ciscoheat/sveltekit-rate-limiter/issues",
  "repository": {
    "url": "https://github.com/ciscoheat/sveltekit-rate-limiter"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm-run-all -s check build test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "vitest run",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "svelte": "./dist/server/index.js"
    },
    "./server/limiters": {
      "types": "./dist/server/limiters/index.d.ts",
      "svelte": "./dist/server/limiters/index.js"
    },
    "./server/stores": {
      "types": "./dist/server/stores/index.d.ts",
      "svelte": "./dist/server/stores/index.js"
    }
  },
  "typesVersions": {
    ">4.0": {
      "server": [
        "./dist/server/index.d.ts"
      ]
    }
  },
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.12.0 || >=3.0.0-next.25 <4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0-next.3",
    "@sveltejs/adapter-cloudflare": "8.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.25",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "nanoid": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.24",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  },
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@11.21.0"
}
